PORT=3000

# Token of your Eitaa app/bot, from https://eitaayar.ir panel. Required unless
# DEV_SKIP_AUTH=1 — the server refuses to start without it in that case.
EITAA_BOT_TOKEN=

# Random long secret (32+ random chars) used to sign session tokens issued by
# this server. Required — the server refuses to start with a short/default
# value. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# Absolute path to a MOUNTED PERSISTENT VOLUME where the SQLite database file
# is stored. On most PaaS platforms (including Hamravesh) the container's own
# disk is wiped on every redeploy/restart, so this must point at an actually
# persistent volume/disk, e.g. "/data". Defaults to ./data for local dev.
DATA_DIR=

# Comma-separated list of origins allowed to call this API via CORS. Only
# needed if the frontend is hosted on a different domain than this backend.
# Leave empty if the backend also serves the frontend (same-origin).
ALLOWED_ORIGINS=

# Set to "1" to skip initData hash validation (local dev only, outside Eitaa client)
DEV_SKIP_AUTH=0
