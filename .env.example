PORT=3000

# Token of your Eitaa app/bot, from https://eitaayar.ir panel
EITAA_BOT_TOKEN=

# Random long secret used to sign session tokens issued by this server
APP_SECRET=change-me-to-a-long-random-string

# Set to "1" to skip initData hash validation (local dev only, outside Eitaa client)
DEV_SKIP_AUTH=0
